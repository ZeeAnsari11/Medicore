# Render injects PORT itself; this is only the local default.
PORT=4000
# Must point at a replica set (even a single-node one) from Phase 2 onward —
# batch/inventory writes use multi-document transactions, which standalone
# mongod cannot provide. MongoDB Atlas is a replica set out of the box.
# Local:  mongodb://127.0.0.1:27017/medicore_dev?replicaSet=rs0
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medicore?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/medicore_dev?replicaSet=rs0
# Production refuses to boot with a missing or default secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN_SECONDS=86400
# Comma-separated browser origins allowed by CORS, no trailing slash.
# Production example: https://your-app.vercel.app
CLIENT_URL=http://localhost:3000,http://localhost:1420,http://localhost:8081

# Platform admin bootstrap (required for production; omitting means no SUPER_ADMIN will exist)
PLATFORM_TENANT_NAME=Medicore Platform
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
