{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "(tenant-isolation|ssr|invoice-edit|cash-receipt).*\\.e2e-spec\\.ts$",
  "testTimeout": 60000,
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "commonjs",
          "moduleResolution": "node10",
          "isolatedModules": false,
          "emitDecoratorMetadata": true,
          "experimentalDecorators": true,
          "esModuleInterop": true,
          "target": "ES2023",
          "skipLibCheck": true,
          "strictNullChecks": true
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^uuid$": "<rootDir>/uuid-stub.js"
  },
  "maxWorkers": 1
}